    "axios": "^1.13.1",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-rate-limit": "^8.2.0",
    "express-validator": "7.0.1",
    "firebase-admin": "11.11.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "2.0.0",
    "swagger-autogen": "2.23.7",
